NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/maple


CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=0

SESSION_COOKIE_NAME=maple_sid
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CUSTOMER_SESSION_TTL_DAYS=14
STAFF_SESSION_TTL_HOURS=12

CSRF_SECRET=

# Must be >= 12 in production.
BCRYPT_COST=12

API_PUBLIC_URL=
DEMO_MODE=true
PAYMENT_WINDOW_MINUTES=30

# JazzCash: set MERCHANT_ID, PASSWORD and INTEGRITY_SALT together (from your merchant portal), or leave all empty.
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_PP_VERSION=2.0
# Optional: restrict the hosted page to one method (e.g. MWALLET, MIGS). Empty = all methods enabled for your merchant.
JAZZCASH_TXN_TYPE=
# Optional overrides if JazzCash issued different URLs for your account.
JAZZCASH_PAYMENT_URL=
JAZZCASH_INQUIRY_URL=

# Easypaisa (Easypay): STORE_ID turns it on. HASH_KEY must match the Easypay merchant portal (16, 24 or 32 characters).
EASYPAISA_ENV=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
# Optional server-side status check, only if Easypaisa gave you these for your account.
EASYPAISA_INQUIRY_URL=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=

# ---------------- Shipping (Phase 5) ----------------
# Where parcels are picked up. Required as soon as any courier below is configured.
SHIP_FROM_NAME=
SHIP_FROM_PHONE=
SHIP_FROM_CITY=
SHIP_FROM_ADDRESS=

# TCS (Envio/OCI e-commerce API). Set all four, or leave empty. Sandbox first; production needs TCS sign-off after UAT.
TCS_ENV=sandbox
TCS_USERNAME=
TCS_PASSWORD=
TCS_ACCOUNT_NUMBER=
TCS_COST_CENTER_CODE=
TCS_SERVICE_CODE=O

# Leopards (backup courier). Set all three, or leave empty. The base URL is issued by Leopards for your account
# (the sandbox and live hosts differ) and is deliberately not guessed here.
LEOPARDS_BASE_URL=
LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=


RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Sentry: create a Node project and paste its DSN. Empty = monitoring off.
SENTRY_DSN=
SENTRY_RELEASE=
